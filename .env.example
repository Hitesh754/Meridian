# ==============================================================================
# MERIDIAN ENVIRONMENT CONFIGURATION (DEV ONLY)
# ==============================================================================
# Copy this file to .env before starting the development stack.
# All values here are dev-safe defaults. Never commit real tokens or credentials.

# Docker Compose Profiles
COMPOSE_PROFILES=core

# Database (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=meridian_dev
POSTGRES_PASSWORD=meridian_dev_secret
POSTGRES_DB=meridian
POSTGRES_PORT=5432
DATABASE_URL=postgres://meridian_dev:meridian_dev_secret@127.0.0.1:5432/meridian

# Fastify API Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Mobile App Connection URLs
# For Android physical device with USB debugging (`adb reverse tcp:8080 tcp:8080`): http://localhost:8080
# For Android Emulator: http://10.0.2.2:8080
# For LAN access: http://<YOUR_WINDOWS_LAN_IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Mapbox Access Tokens (FREE TIER ONLY - CANNOT EXCEED 100 MAU FREE CAP)
# Public token (pk.*) for mobile map rendering:
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Secret token (sk.* with Downloads:Read scope) for Gradle/Maven SDK download only:
# Do NOT commit. Must be kept in ~/.gradle/gradle.properties or local .env.
MAPBOX_DOWNLOADS_TOKEN=
