{
  "version": 8,
  "name": "Meridian Light",
  "metadata": {
    "meridian:theme": "light",
    "meridian:version": "1.0.0"
  },
  "sources": {
    "mapbox-streets": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F8F9FA"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "water",
      "paint": {
        "fill-color": "#C8DCED"
      }
    },
    {
      "id": "landuse-greenery",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "pitch", "grass", "wood", "scrub"],
      "paint": {
        "fill-color": "#E2F0D9",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "building",
      "paint": {
        "fill-color": "#ECEFF1",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "motorway", "motorway_link"],
      "paint": {
        "line-color": "#D97706",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2, 14, 8, 18, 14]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "motorway", "motorway_link"],
      "paint": {
        "line-color": "#F59E0B",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.5, 14, 6, 18, 12]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#CBD5E1",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 14, 5, 18, 10]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 4, 18, 8]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "secondary", "tertiary"],
      "minzoom": 10,
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 14, 3, 18, 6]
      }
    },
    {
      "id": "road-local",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "street", "street_limited", "service"],
      "minzoom": 12,
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 14, 2, 18, 4]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "mapbox-streets",
      "source-layer": "road",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "mapbox-streets",
      "source-layer": "place_label",
      "filter": ["in", "type", "city", "town", "village"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 16]
      },
      "paint": {
        "text-color": "#0F172A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2
      }
    }
  ]
}
