{
  "version": 8,
  "name": "Meridian Dark",
  "metadata": {
    "meridian:theme": "dark",
    "meridian:version": "1.0.0"
  },
  "sources": {
    "mapbox-streets": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0F172A"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0B2545"
      }
    },
    {
      "id": "landuse-greenery",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "pitch", "grass", "wood", "scrub"],
      "paint": {
        "fill-color": "#132A22",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "building",
      "paint": {
        "fill-color": "#1E293B",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "motorway", "motorway_link"],
      "paint": {
        "line-color": "#B45309",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2, 14, 8, 18, 14]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "motorway", "motorway_link"],
      "paint": {
        "line-color": "#F59E0B",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.5, 14, 6, 18, 12]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#090D16",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 14, 5, 18, 10]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#334155",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 4, 18, 8]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "secondary", "tertiary"],
      "minzoom": 10,
      "paint": {
        "line-color": "#243248",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 14, 3, 18, 6]
      }
    },
    {
      "id": "road-local",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", "class", "street", "street_limited", "service"],
      "minzoom": 12,
      "paint": {
        "line-color": "#1E293B",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 14, 2, 18, 4]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "mapbox-streets",
      "source-layer": "road",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#E2E8F0",
        "text-halo-color": "#0F172A",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "mapbox-streets",
      "source-layer": "place_label",
      "filter": ["in", "type", "city", "town", "village"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 16]
      },
      "paint": {
        "text-color": "#F8FAFC",
        "text-halo-color": "#0F172A",
        "text-halo-width": 2
      }
    }
  ]
}
