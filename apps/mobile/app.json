{
  "expo": {
    "name": "Meridian",
    "slug": "meridian",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "meridian",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.meridian.mobile"
    },
    "android": {
      "package": "app.meridian.mobile",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Meridian to access your location for turn-by-turn road navigation and safety alerts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
